{
  "name": "adb-gui-next",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "RUST_BACKTRACE=1 tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:web": "ultracite check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint": "bun run lint:web && bun run lint:rust",
    "format:web": "ultracite fix",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "format": "bun run format:web && bun run format:rust",
    "format:check": "bun run lint:web && bun run format:rust:check",
    "check": "ultracite check",
    "version:sync": "bun scripts/sync-cargo-version.mjs",
    "prepare": "husky",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@visx/curve": "4.0.0",
    "@visx/event": "4.0.0",
    "@visx/gradient": "4.0.0",
    "@visx/grid": "4.0.1-alpha.0",
    "@visx/group": "4.0.1-alpha.0",
    "@visx/pattern": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-array": "^3.2.5",
    "d3-shape": "^3.2.1",
    "effect": "^4.1.4",
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "next-themes": "^0.4.6",
    "path-browserify": "^1.0.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "8.2.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "bun x ultracite fix"
    ],
    "src-tauri/**/*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  },
  "packageManager": "bun@1.3.14"
}
