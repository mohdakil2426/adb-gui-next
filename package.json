  "name": "adb-gui-next",
  "scripts": {
    "dev": "vite",
    "dev:debug": "RUST_BACKTRACE=1 tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:web": "ultracite check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint": "bun run lint:web && bun run lint:rust",
    "format:web": "ultracite fix",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "format": "bun run format:web && bun run format:rust",
    "format:check": "bun run lint:web && bun run format:rust:check",
    "check": "bun run format:check && bun run lint:rust && bun run test && cargo test --manifest-path src-tauri/Cargo.toml && bun run build",
    "version:sync": "bun scripts/sync-cargo-version.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "bun x ultracite fix"
    ],
    "src-tauri/**/*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  },
  "type": "module",
  "version": "0.2.5",
  "private": true,
  "packageManager": "bun@1.3.14"
}
