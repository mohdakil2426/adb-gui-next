{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "scrcpy-toolbar-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "log:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-device-read",
    "allow-device-mutate"
  ]
}
